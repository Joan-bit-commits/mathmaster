# MathMaster backend environment
# Copy to backend/.env and fill in real values. Never commit .env.

# Core Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Postgres)
DB_NAME=mathmaster_db
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5433

# Google Gemini
GENAI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# JWT
JWT_ACCESS_MIN=60
JWT_REFRESH_DAYS=1
JWT_ROTATE_REFRESH=false

# CORS (comma-separated list of exact origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging
LOG_LEVEL=INFO

# Throttling (DRF syntax: n/second|minute|hour|day)
THROTTLE_ANON_RATE=30/min
THROTTLE_USER_RATE=200/min

# Pagination
PAGE_SIZE=20

# Recommendations
RECOMMENDATION_TTL_DAYS=14
RECOMMENDATION_MIN_AVG_SCORE=60
RECOMMENDATION_MAX_ITEMS=5

# Optional error tracking (leave empty to disable)
SENTRY_DSN=

# Production-only (used when DEBUG=false)
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000