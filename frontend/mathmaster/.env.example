# ─── Runtime env (injected at build time by Vite) ───────────────
# VITE_ variables are BAKED INTO the bundle at `npm run build` —
# they are NOT secret and NOT changeable after deploy.

# API base URL the browser will call (no trailing slash).
# Staging/prod example: https://api.mathmaster.app
VITE_API_URL=http://127.0.0.1:8000

# 'true' runs the app fully on canned mock data (demo mode, no backend).
VITE_USE_MOCKS=false

# Optional: sentry / analytics DSNs go here when wired up.
