# Copy to .env.prod and replace every placeholder before deploying.
SECRET_KEY=replace-with-a-long-random-production-secret
DEBUG=false
ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com

DB_ENGINE=django.db.backends.postgresql
DB_NAME=mathmaster_db
DB_USER=mathmaster
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=postgres
DB_PORT=5432

# PostgreSQL container variables used by docker-compose.prod.yml.
POSTGRES_DB=mathmaster_db
POSTGRES_USER=mathmaster
POSTGRES_PASSWORD=replace-with-a-strong-database-password

REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false
GENAI_API_KEY=replace-with-your-gemini-api-key
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=180